[Unit]
Description=Origin v3 tutorial application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=origin
WorkingDirectory=/opt/origin-tutorial
ExecStart=/opt/origin-tutorial/hello-service start --app-name origin-tutorial --config /etc/origin-tutorial --node hello-1
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
